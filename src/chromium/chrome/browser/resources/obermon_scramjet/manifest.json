{
  "manifest_version": 3,
  "name": "Scramjet",
  "version": "1.0.0",
  "description": "Built-in Obermon Scramjet privacy and mediation control.",
  "key": "",
  "permissions": ["tabs", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:4141/*"],
  "background": {"service_worker": "background.js"},
  "action": {
    "default_title": "Scramjet",
    "default_popup": "popup.html"
  },
  "incognito": "split"
}

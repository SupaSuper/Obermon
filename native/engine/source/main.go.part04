			return errors.New("CONNECT payload too short")
		}
		streamType := payload[0]
		port := binary.LittleEndian.Uint16(payload[1:3])
		hostname := strings.TrimSpace(string(payload[3:]))
		if hostname == "" || port == 0 || (streamType != streamTCP && streamType != streamUDP) {
			return errors.New("invalid CONNECT payload")
		}
		s.openStream(streamID, streamType, hostname, port)
		return nil
	case packetData:
		st := s.getStream(streamID)
		if st == nil {
			return fmt.Errorf("DATA for unknown stream %d", streamID)
		}
		data := append([]byte(nil), payload...)
		select {
		case st.outbound <- data:
			return nil
		case <-st.done:
			return nil
		case <-s.closed:
			return io.EOF
		}
	case packetClose:
		s.closeStream(streamID, 0, false)
		return nil
	case packetContinue:
		return errors.New("client sent CONTINUE")
	case packetInfo:
		return errors.New("unexpected INFO after handshake")
	default:
		return fmt.Errorf("unknown Wisp packet type %d", packetType)
	}
}

func (s *wispSession) openStream(id uint32, streamType byte, hostname string, port uint16) {
	if id == 0 {
		return
	}
	st := &wispStream{
		id:       id,
		typeID:   streamType,
		hostname: hostname,
		port:     port,
		session:  s,
		outbound: make(chan []byte, streamBufferSize),
		done:     make(chan struct{}),
	}

	s.mu.Lock()
	if old := s.streams[id]; old != nil {
		old.close(0, false)
	}
	s.streams[id] = st
	s.mu.Unlock()
	go st.run()
}

func (s *wispSession) getStream(id uint32) *wispStream {
	s.mu.RLock()
	defer s.mu.RUnlock()
	return s.streams[id]
}

func (s *wispSession) closeStream(id uint32, reason byte, notify bool) {
	if st := s.getStream(id); st != nil {
		st.close(reason, notify)
	}
}

func (s *wispSession) removeStream(id uint32, st *wispStream) {
	s.mu.Lock()
	if s.streams[id] == st {
		delete(s.streams, id)
	}
	s.mu.Unlock()
}

func (s *wispSession) sendPacket(packetType byte, streamID uint32, payload []byte) error {
	packet := make([]byte, 5+len(payload))
	packet[0] = packetType
	binary.LittleEndian.PutUint32(packet[1:5], streamID)
	copy(packet[5:], payload)
	return s.ws.writeBinary(packet)
}

func (s *wispSession) shutdown() {
	s.once.Do(func() {
		close(s.closed)
		s.mu.RLock()
		streams := make([]*wispStream, 0, len(s.streams))
		for _, st := range s.streams {
			streams = append(streams, st)
		}
		s.mu.RUnlock()
		for _, st := range streams {
			st.close(0, false)
		}
		s.ws.close()
	})
}

type wispStream struct {
	id       uint32
	typeID   byte
	hostname string
	port     uint16
	session  *wispSession
	outbound chan []byte
	done     chan struct{}

	conn net.Conn
	once sync.Once
}

func (st *wispStream) run() {
	network := "tcp"
	if st.typeID == streamUDP {
		network = "udp"
	}
	address := net.JoinHostPort(st.hostname, strconv.Itoa(int(st.port)))
	conn, err := net.DialTimeout(network, address, 20*time.Second)
	if err != nil {
		log.Printf("Wisp stream %d connect %s failed: %v", st.id, address, err)
		st.close(closeNetworkErr, true)
		return
	}
	select {
	case <-st.done:
		_ = conn.Close()
		return
	default:
	}
	st.conn = conn
	select {
	case <-st.done:
		_ = conn.Close()
		return
	default:
	}
	if tcp, ok := conn.(*net.TCPConn); ok {
		_ = tcp.SetNoDelay(true)
	}

	go st.clientToRemote()
	st.remoteToClient()
}

func (st *wispStream) clientToRemote() {
	packets := uint32(0)
	for {
		select {
		case data := <-st.outbound:
			if len(data) == 0 {
				continue
			}
			if _, err := st.conn.Write(data); err != nil {
				st.close(closeNetworkErr, true)
				return
			}
			packets++
			if packets%(streamBufferSize/2) == 0 {
				remaining := streamBufferSize - uint32(len(st.outbound))
				payload := make([]byte, 4)
				binary.LittleEndian.PutUint32(payload, remaining)
				if err := st.session.sendPacket(packetContinue, st.id, payload); err != nil {
					st.close(0, false)
					return
				}
			}
		case <-st.done:
			return
		case <-st.session.closed:
			return
		}
	}
}

func (st *wispStream) remoteToClient() {
	buffer := make([]byte, 64*1024)
	for {
		n, err := st.conn.Read(buffer)
		if n > 0 {
			if sendErr := st.session.sendPacket(packetData, st.id, buffer[:n]); sendErr != nil {
				st.close(0, false)
				return
			}
		}
		if err != nil {
			if errors.Is(err, io.EOF) {
				st.close(closeVoluntary, true)
			} else {
				st.close(closeNetworkErr, true)
			}
			return
		}
	}
}

func (st *wispStream) close(reason byte, notify bool) {
	st.once.Do(func() {
		close(st.done)
		if st.conn != nil {
			_ = st.conn.Close()
		}
		st.session.removeStream(st.id, st)
		if notify && reason != 0 {
			_ = st.session.sendPacket(packetClose, st.id, []byte{reason})
		}
	})
}
